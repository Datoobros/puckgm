# Copy to .env.local and fill in once accounts exist (see ../DESIGN.md and ../ROADMAP.md).

# Neon Postgres connection string (neon.tech project settings)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clerk auth (clerk.com dashboard -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Random secret guarding the daily-ingest cron route from public triggering.
# Vercel attaches this automatically as a Bearer token for cron-triggered
# requests once set in Vercel project env vars. Generate any random string,
# e.g.: openssl rand -hex 32
CRON_SECRET=""
