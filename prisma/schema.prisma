// Prisma schema for the dynasty fantasy hockey GM sim.
// Mirrors the data model in ../../DESIGN.md §4. Keep them in sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 4.1 Player identity — internal IDs, mapped to external sources.
// Never key application logic off a vendor ID directly.
// ---------------------------------------------------------------------------

model Player {
  id              String   @id @default(cuid())
  fullName        String
  dob             DateTime?
  primaryPosition String? // C, LW, RW, D, G
  shoots          String? // L, R
  currentNhlOrg   String? // team abbrev, e.g. "EDM" — derived, refreshed from NHL data
  careerNhlGp     Int      @default(0) // derived — drives the 80-GP waiver exemption
  officialRosterStatus String? // ACTIVE | IR | LTIR — derived from source data, see DESIGN.md §2.6
  // Real NHL Entry Draft metadata (src/lib/players/draftClass.ts) — set only
  // for players ingested as a rookie-draft-eligible class. currentNhlOrg
  // above is set to the *drafting* team for these, satisfying DESIGN.md
  // §2.1's "tied to an NHL organization" rule even pre-debut. No season
  // stats exist for these players — name/org/position only, by design (see
  // PROGRESS.md's Draft section for why).
  draftYear         Int?
  draftRound        Int?
  draftOverallPick  Int?
  amateurLeague     String?
  amateurClubName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sourceIds     PlayerSourceId[]
  statLines     GameStatLine[]
  rosterSlots   RosterSlot[]
  draftPickUsed DraftPick[]
  tradeItems    TradeItem[]
  fabids        FaBid[]
  waiverClaims  WaiverClaim[]
  lineupEntries LineupEntry[]

  @@index([currentNhlOrg])
}

model PlayerSourceId {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id])
  source   String // 'nhl' | 'espn' | 'eliteprospects'
  sourceId String

  @@unique([source, sourceId])
  @@index([playerId])
}

// Raw stat lines only. Fantasy points are always computed on read against a
// league's scoring config — never persisted. See DESIGN.md §4.1.
model GameStatLine {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  gameId    String // NHL game id
  gameDate  DateTime
  league    String   @default("NHL")
  statsJson Json
  createdAt DateTime @default(now())

  @@unique([playerId, gameId])
  @@index([gameDate])
}

// ---------------------------------------------------------------------------
// Leagues, settings, teams
// ---------------------------------------------------------------------------

model League {
  id            String   @id @default(cuid())
  name          String
  seasonFounded Int
  // The season every "current standings/schedule/draft/FAAB" lookup actually
  // uses — see src/lib/matchups/constants.ts's CURRENT_SCHEDULE_SEASON for
  // why this replaced a single global constant. Defaults to the pre-existing
  // global value so every league created before this field existed is
  // unaffected; createLeague sets it explicitly to the creation season going
  // forward. Only ever advanced by startNewSeasonAction (REDRAFT leagues).
  currentSeason Int      @default(2026)
  settingsJson  Json // includes mutability-tiered settings, see DESIGN.md §2.10
  createdAt     DateTime @default(now())
  // Shareable join link (src/lib/leagues/mutations.ts regenerateInviteCode) —
  // nullable because it's generated lazily on first "Generate invite link"
  // click, not backfilled for leagues that predate this feature. Regenerating
  // overwrites this, which is the only revocation mechanism.
  inviteCode String? @unique
  // Nullable so this migration is safe against leagues created before this
  // field existed — mutations.ts falls back to the earliest team's manager
  // for those. Always set going forward (createLeague sets it to the
  // creating manager).
  commissionerUserId String?
  // Waiver claim priority queue — ordered array of team IDs, index 0 = next
  // to win a contested claim (src/lib/waivers/mutations.ts). Nullable and
  // lazily initialized on first use, same pattern as commissionerUserId.
  // Seeded as reverse team-creation order: there's no draft feature yet to
  // seed this from real draft order (DESIGN.md §2.3 says "reverse
  // standings", but the user overrode that — no season data exists yet
  // either — in favor of a rotating queue that's the permanent mechanic,
  // not just a bootstrap). Winning a claim sends that team to the back.
  waiverPriorityJson Json?

  teams            Team[]
  settingsLog      LeagueSettingsLog[]
  draftPicks       DraftPick[]
  drafts           Draft[]
  trades           Trade[]
  matchupPeriods   MatchupPeriod[]
}

model LeagueSettingsLog {
  id        String   @id @default(cuid())
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id])
  field     String
  oldValue  Json?
  newValue  Json
  changedAt DateTime @default(now())
  changedBy String // user id
}

enum TeamState {
  ACTIVE
  ORPHAN_FROZEN
}

model Team {
  id            String    @id @default(cuid())
  leagueId      String
  league        League    @relation(fields: [leagueId], references: [id])
  name          String
  managerUserId String
  state         TeamState @default(ACTIVE)
  createdAt     DateTime  @default(now())

  rosterSlots       RosterSlot[]
  draftPicksOwned   DraftPick[]        @relation("CurrentOwner")
  draftPicksOrig    DraftPick[]        @relation("OriginalOwner")
  tradeItemsFrom    TradeItem[]        @relation("FromTeam")
  tradeItemsTo      TradeItem[]        @relation("ToTeam")
  tradesProposed    Trade[]            @relation("TradeProposedBy")
  tradeVetoesCast   TradeVeto[]
  faabBudgets       FaabBudget[]
  faBids            FaBid[]
  waiverClaims      WaiverClaim[]
  lineupEntries     LineupEntry[]
  homeMatchups      Matchup[]          @relation("MatchupHomeTeam")
  awayMatchups      Matchup[]          @relation("MatchupAwayTeam")

  @@index([leagueId])
}

// ---------------------------------------------------------------------------
// Rosters — ACTIVE / FARM / IR. See DESIGN.md §2.3–2.6.
// ---------------------------------------------------------------------------

enum RosterSlotType {
  ACTIVE
  FARM
  IR
}

model RosterSlot {
  id             String         @id @default(cuid())
  teamId         String
  team           Team           @relation(fields: [teamId], references: [id])
  playerId       String
  player         Player         @relation(fields: [playerId], references: [id])
  slotType       RosterSlotType
  effectiveFrom  DateTime       @default(now())
  effectiveTo    DateTime?
  // Demotion waivers (DESIGN.md §2.3/§2.9, src/lib/waivers/mutations.ts). Set
  // only on a FARM slot created by sendToFarm when the demoted player is
  // waiver-exposed — presence + effectiveTo: null + not yet past this time
  // means "currently claimable." Cleared or the slot closes once processed.
  waiverExpiresAt DateTime?
  // Set on the new ACTIVE slot created when a waiver claim is awarded. Lets
  // sendToFarm exempt a just-claimed player from immediately re-triggering
  // waiverExposed if his new team sends him right back down.
  waiverClaimedAt DateTime?
  // Same exemption idea as waiverClaimedAt, but for a trade (src/lib/trades/
  // mutations.ts) — 24h, not 48h, and tracked separately since the two
  // acquisition paths have different grace windows.
  tradeAcquiredAt DateTime?

  @@index([teamId, slotType])
  @@index([playerId])
}

// ---------------------------------------------------------------------------
// Draft picks — first-class tradeable objects. DESIGN.md §2.8 / §4.1.
// ---------------------------------------------------------------------------

model DraftPick {
  id                String   @id @default(cuid())
  leagueId          String
  league            League   @relation(fields: [leagueId], references: [id])
  season            Int
  round             Int
  originalTeamId    String
  originalTeam      Team     @relation("OriginalOwner", fields: [originalTeamId], references: [id])
  currentOwnerId    String
  currentOwner      Team     @relation("CurrentOwner", fields: [currentOwnerId], references: [id])
  lotteryResult     Int? // final pick number after lottery
  usedOnPlayerId    String?
  usedOnPlayer      Player?  @relation(fields: [usedOnPlayerId], references: [id])
  // Draft room (src/lib/draft/mutations.ts). overallPick is the global
  // sequence position across every round of the draft it belongs to — the
  // pick with the lowest overallPick and no usedOnPlayerId is whoever's on
  // the clock. draftId links back to that live session; nullable because a
  // DraftPick can exist (and be traded) before draftId meant anything here.
  overallPick       Int?
  draftId           String?
  draft             Draft?   @relation(fields: [draftId], references: [id])

  tradeItems TradeItem[]

  @@index([leagueId, season])
}

// ---------------------------------------------------------------------------
// The draft (startup or annual rookie). DESIGN.md §2.8, src/lib/draft/mutations.ts.
// No cron involvement — the live room's clock resolves itself on every read
// (same "compute the true current state on read" principle already used for
// fantasy points/scores), since Vercel Hobby's once-daily cron can't drive a
// live countdown and this app has no other live-update infrastructure.
// ---------------------------------------------------------------------------

enum DraftType {
  STARTUP
  ROOKIE
}

enum DraftStatus {
  SETUP // DraftPicks exist (and are already real, tradeable rows) — clock not running yet
  IN_PROGRESS
  COMPLETE
}

model Draft {
  id                  String      @id @default(cuid())
  leagueId            String
  league              League      @relation(fields: [leagueId], references: [id])
  season              Int
  type                DraftType
  status              DraftStatus @default(SETUP)
  pickTimerSeconds    Int         @default(90)
  currentPickDeadline DateTime?
  createdAt           DateTime    @default(now())

  picks DraftPick[]

  @@unique([leagueId, season, type])
}

// ---------------------------------------------------------------------------
// Trades — with review window. DESIGN.md §2.11.
// ---------------------------------------------------------------------------

enum TradeState {
  PROPOSED
  UNDER_REVIEW
  VETOED
  PROCESSED
  CANCELLED
  DECLINED
}

model Trade {
  id               String     @id @default(cuid())
  leagueId         String
  league           League     @relation(fields: [leagueId], references: [id])
  proposedAt       DateTime   @default(now())
  // Who initiated — the counterparty is derived at runtime from the distinct
  // team ids on this trade's TradeItems (src/lib/trades/mutations.ts scopes
  // this to exactly two teams for now, though the schema doesn't enforce it).
  proposedByTeamId String
  proposedByTeam   Team       @relation("TradeProposedBy", fields: [proposedByTeamId], references: [id])
  // Set only once the counterparty accepts — null while still PROPOSED.
  respondedAt      DateTime?
  // The 24h review window's end; null until respondedAt is set.
  reviewEndsAt     DateTime?
  state            TradeState @default(PROPOSED)

  items TradeItem[]
  vetoes TradeVeto[]

  @@index([leagueId, state])
}

// One row per team that has cast a veto vote on a trade — works for both
// governance models (LeagueSettings.tradeVetoMode): a single row from the
// commissioner's team is decisive in COMMISSIONER mode; rows are counted
// against the eligible-voter majority in VOTE mode. See castTradeVeto.
model TradeVeto {
  id        String   @id @default(cuid())
  tradeId   String
  trade     Trade    @relation(fields: [tradeId], references: [id])
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tradeId, teamId])
}

enum TradeItemType {
  PLAYER
  PICK
  FAAB
}

model TradeItem {
  id         String        @id @default(cuid())
  tradeId    String
  trade      Trade         @relation(fields: [tradeId], references: [id])
  fromTeamId String
  fromTeam   Team          @relation("FromTeam", fields: [fromTeamId], references: [id])
  toTeamId   String
  toTeam     Team          @relation("ToTeam", fields: [toTeamId], references: [id])
  itemType   TradeItemType
  playerId   String?
  player     Player?       @relation(fields: [playerId], references: [id])
  draftPickId String?
  draftPick  DraftPick?    @relation(fields: [draftPickId], references: [id])
  faabAmount Int?
}

// ---------------------------------------------------------------------------
// FAAB / the wire. DESIGN.md §2.7 / §2.9.
// ---------------------------------------------------------------------------

model FaabBudget {
  id              String @id @default(cuid())
  teamId          String
  team            Team   @relation(fields: [teamId], references: [id])
  season          Int
  startingAmount  Int
  remaining       Int

  @@unique([teamId, season])
}

enum FaBidResult {
  PENDING
  WON
  LOST
}

model FaBid {
  id           String      @id @default(cuid())
  teamId       String
  team         Team        @relation(fields: [teamId], references: [id])
  playerId     String
  player       Player      @relation(fields: [playerId], references: [id])
  amount       Int
  targetSlot   RosterSlotType
  processDate  DateTime
  result       FaBidResult @default(PENDING)
  createdAt    DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Demotion waivers. DESIGN.md §2.3 / §2.9 — distinct from the wire (FA claims).
// ---------------------------------------------------------------------------

enum WaiverClaimResult {
  PENDING
  AWARDED
  CLEARED
}

model WaiverClaim {
  id              String            @id @default(cuid())
  teamId          String
  team            Team              @relation(fields: [teamId], references: [id])
  playerId        String
  player          Player            @relation(fields: [playerId], references: [id])
  priorityAtClaim Int
  result          WaiverClaimResult @default(PENDING)
  createdAt       DateTime          @default(now())
}

// ---------------------------------------------------------------------------
// Matchups and lineups. DESIGN.md §2.4.
// ---------------------------------------------------------------------------

model MatchupPeriod {
  id         String   @id @default(cuid())
  leagueId   String
  league     League   @relation(fields: [leagueId], references: [id])
  season     Int
  periodNo   Int
  startDate  DateTime
  endDate    DateTime
  // Playoff bracket (src/lib/matchups/playoffs.ts). Playoff periods are
  // created empty at schedule-generation time — nothing to pair until the
  // regular season actually finishes — and get their Matchup rows filled in
  // round by round by the daily cron.
  isPlayoffs Boolean  @default(false)

  matchups Matchup[]

  @@unique([leagueId, season, periodNo])
}

// Team-vs-team pairing within a matchup period. No score fields here —
// like fantasy points (DESIGN.md §4.1), a matchup's score is always
// computed on read from LineupEntry + GameStatLine, never persisted, so a
// retroactive stat correction can't desync a stored result from reality.
// See src/lib/matchups/standings.ts.
model Matchup {
  id              String        @id @default(cuid())
  matchupPeriodId String
  matchupPeriod   MatchupPeriod @relation(fields: [matchupPeriodId], references: [id])
  homeTeamId      String
  homeTeam        Team          @relation("MatchupHomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId      String
  awayTeam        Team          @relation("MatchupAwayTeam", fields: [awayTeamId], references: [id])
  // Playoff bracket only — null for regular-season matchups. Seeds are set
  // once from final regular-season standings and carried forward round to
  // round; bracketSlot is the round-relative pairing index used purely for
  // advancement (round N's slot i is built from round N-1's slots 2i/2i+1).
  homeSeed        Int?
  awaySeed        Int?
  bracketSlot     Int?

  @@index([matchupPeriodId])
}

// Lineups are pre-set and freely editable, no weekly lock — only a per-game
// lock once a player's own game starts. DESIGN.md §2.4.
model LineupEntry {
  id         String   @id @default(cuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id])
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id])
  gameDate   DateTime
  lineupSlot String // e.g. "C1", "LW1", "D2", "UTIL", "BE"
  createdAt  DateTime @default(now())

  @@unique([teamId, playerId, gameDate])
}

// ---------------------------------------------------------------------------
// Append-only transaction log. DESIGN.md §4.1 — the source of truth for
// "why does this team own this pick / this player." Never mutate a row here;
// corrections are new rows.
// ---------------------------------------------------------------------------

model TransactionLog {
  id          String   @id @default(cuid())
  leagueId    String
  type        String // CALLUP | SEND_DOWN | IR_MOVE | TRADE | FAAB_WIN | WAIVER_CLAIM | DRAFT_PICK | LINEUP_EDIT
  actorTeamId String?
  payload     Json
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([leagueId, type])
  @@index([actorTeamId])
}
